// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SUPERVISOR
  CASHIER
}

enum CustomerType {
  REGULAR
  SPECIAL
}

enum PaymentMethod {
  CASH
  NEQUI
  BANCOLOMBIA
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum LoanStatus {
  ACTIVE
  PAID
}

enum InventoryMovementType {
  SALE
  RETURN
  EXCHANGE
  BRANCH_TRANSFER
  STOCK_IN
  STOCK_OUT
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

model Company {
  id          String  @id @default(uuid())
  name        String
  description String?

  branches Branch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id      String  @id @default(uuid())
  name    String
  address String?
  phone   String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  users       User[]
  customers   Customer[]
  inventories Inventory[]

  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  sales        Sale[]
  movements    InventoryMovement[]
  cashSessions CashSession[]
}

model User {
  id String @id @default(uuid())

  username     String @unique
  passwordHash String

  role Role

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  // Vinculación con Telegram: el usuario genera un código en la app y lo
  // envía al bot con /vincular; el webhook guarda el chat y lo verifica.
  telegramChatId      String?
  telegramLinkCode    String?   @unique
  telegramLinkExpires DateTime?
  telegramVerifiedAt  DateTime?

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sales         Sale[]
  refreshTokens RefreshToken[]
  cashSessions  CashSession[]
}

model Customer {
  id String @id @default(uuid())

  firstName String
  lastName  String?

  phone   String?
  address String?

  type CustomerType @default(REGULAR)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
  loans     Loan[]
}

model Category {
  id String @id @default(uuid())

  name String

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id String @id @default(uuid())

  name String

  barcode String @unique

  purchasePrice Decimal
  salePrice     Decimal

  isActive Boolean @default(true)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  inventories Inventory[]

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  saleDetails SaleDetail[]
  movements   InventoryMovement[]
}

model Inventory {
  id String @id @default(uuid())

  amount Int @default(0)

  branchId  String
  productId String

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements InventoryMovement[]

  @@unique([branchId, productId])
}

// Sesión de caja de una sucursal: apertura con base en efectivo, ventas del
// turno vinculadas, y cierre con el efectivo contado. Solo puede haber una
// abierta por sucursal (validado en el servicio).
model CashSession {
  id String @id @default(uuid())

  openingAmount Decimal
  closingAmount Decimal?

  status CashSessionStatus @default(OPEN)

  branchId   String
  openedById String

  branch   Branch @relation(fields: [branchId], references: [id])
  openedBy User   @relation(fields: [openedById], references: [id])

  sales Sale[]

  openedAt DateTime  @default(now())
  closedAt DateTime?

  @@index([branchId, status])
}

model Sale {
  id String @id @default(uuid())

  invoiceNumber Int

  total Decimal

  payments SalePayment[]

  isCredit Boolean @default(false)

  status SaleStatus @default(COMPLETED)

  branchId   String
  userId     String
  customerId String?
  loan       Loan?

  // Caja abierta a la que quedó asociada la venta (trazabilidad del turno).
  cashSessionId String?
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id])

  branch   Branch    @relation(fields: [branchId], references: [id])
  user     User      @relation(fields: [userId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  details SaleDetail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, invoiceNumber])
}

model SaleDetail {
  id String @id @default(uuid())

  saleId    String
  productId String

  quantity Int

  unitPrice Decimal
  discount  Decimal @default(0)

  // Motivo del descuento aplicado (si existe), para el cierre de caja.
  discountReason String?

  subtotal Decimal

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements InventoryMovement[]

  @@unique([saleId, productId])
}

model SalePayment {
  id String @id @default(uuid())

  saleId String

  amount Decimal

  paymentMethod PaymentMethod

  sale Sale @relation(fields: [saleId], references: [id])

  createdAt DateTime @default(now())
}

model Loan {
  id String @id @default(uuid())

  originalAmount Decimal
  pendingAmount  Decimal

  saleId     String @unique
  customerId String

  loanStatus LoanStatus @default(ACTIVE)

  payments LoanPayment[]

  sale     Sale     @relation(fields: [saleId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoanPayment {
  id String @id @default(uuid())

  loanId String
  amount Decimal

  paymentMethod PaymentMethod
  loan          Loan          @relation(fields: [loanId], references: [id])

  createdAt DateTime @default(now())
}

model InventoryMovement {
  id String @id @default(uuid())

  inventoryId String
  productId   String
  branchId    String
  note        String?

  quantity Int

  type InventoryMovementType

  // Vincula los dos movimientos (salida del origen, entrada al destino) de una
  // misma transferencia entre sedes. El lado negativo es el origen.
  transferGroupId String?

  saleDetailId String?

  saleDetail SaleDetail? @relation(fields: [saleDetailId], references: [id])
  inventory  Inventory   @relation(fields: [inventoryId], references: [id])
  product    Product     @relation(fields: [productId], references: [id])
  branch     Branch      @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
}
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}