// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SUPERVISOR
  CASHIER
}

enum CustomerType {
  REGULAR
  SPECIAL
}

enum PaymentMethod {
  CASH
  NEQUI
  BANCOLOMBIA
}

enum SaleStatus {
  COMPLETED
  CANCELLED
}

enum LoanStatus {
  ACTIVE
  PAID
}

enum InventoryMovementType {
  SALE
  RETURN
  EXCHANGE
  BRANCH_TRANSFER
  STOCK_IN
  STOCK_OUT
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

// Estado de una solicitud de traslado entre sedes (#2) y de una solicitud de
// cambio de precio (#5): nace PENDING y el administrador la resuelve.
enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Avance de un pedido especial (#3): abonado -> pedido hecho -> llegó al
// local -> recogido por el cliente.
enum SpecialOrderStatus {
  DEPOSITED
  ORDERED
  ARRIVED
  PICKED_UP
}

// Momento del pago de un pedido especial: el abono inicial o el saldo final.
enum SpecialOrderPaymentKind {
  DEPOSIT
  FINAL
}

// Origen de un ítem de la lista de compras (#4): sugerido por el sistema
// según stock/rotación, o agregado manualmente por un vendedor.
enum PurchaseListSource {
  MANUAL
  AUTO
}

model Company {
  id          String  @id @default(uuid())
  name        String
  description String?

  branches Branch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id      String  @id @default(uuid())
  name    String
  address String?
  phone   String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  users       User[]
  customers   Customer[]
  inventories Inventory[]

  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  sales        Sale[]
  movements    InventoryMovement[]
  cashSessions CashSession[]

  transfersFrom     BranchTransferRequest[] @relation("TransferFromBranch")
  transfersTo       BranchTransferRequest[] @relation("TransferToBranch")
  specialOrders     SpecialOrder[]
  purchaseListItems PurchaseListItem[]
}

model User {
  id String @id @default(uuid())

  username     String @unique
  passwordHash String

  role Role

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  // Código pendiente de vinculación con Telegram (un chat a la vez; los
  // chats ya vinculados viven en TelegramLink).
  telegramLinkCode    String?   @unique
  telegramLinkExpires DateTime?

  telegramLinks TelegramLink[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  sales         Sale[]
  refreshTokens RefreshToken[]
  cashSessions  CashSession[]

  transferRequests     BranchTransferRequest[] @relation("TransferRequestedBy")
  transferResolutions  BranchTransferRequest[] @relation("TransferResolvedBy")
  specialOrders        SpecialOrder[]
  purchaseListItems    PurchaseListItem[]
  priceChangeRequests  PriceChangeRequest[]    @relation("PriceRequestedBy")
  priceChangeApprovals PriceChangeRequest[]    @relation("PriceResolvedBy")
}

// Chats de Telegram vinculados a una cuenta (varios por usuario). Se crean
// solo a través del webhook con un código válido.
model TelegramLink {
  id     String  @id @default(uuid())
  chatId String
  label  String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  verifiedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([userId, chatId])
}

model Customer {
  id String @id @default(uuid())

  firstName String
  lastName  String?

  phone   String?
  address String?

  type CustomerType @default(REGULAR)

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
  loans     Loan[]
}

model Category {
  id String @id @default(uuid())

  name String

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id String @id @default(uuid())

  name String

  barcode String @unique

  purchasePrice Decimal
  salePrice     Decimal

  // Precios de venta segun el tipo de cliente. En el checkout se elige uno de
  // los dos por linea y el valor elegido se congela en SaleDetail.unitPrice.
  retailPrice    Decimal @map("precio_detal")
  wholesalePrice Decimal @map("precio_mayor")

  isActive Boolean @default(true)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  inventories Inventory[]

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  saleDetails SaleDetail[]
  movements   InventoryMovement[]

  priceChangeRequests PriceChangeRequest[]
  purchaseListItems   PurchaseListItem[]
  transferRequests    BranchTransferRequest[]
}

model Inventory {
  id String @id @default(uuid())

  amount Int @default(0)

  branchId  String
  productId String

  branch  Branch  @relation(fields: [branchId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements InventoryMovement[]

  @@unique([branchId, productId])
}

// Sesión de caja de una sucursal: apertura con base en efectivo, ventas del
// turno vinculadas, y cierre con el efectivo contado. Solo puede haber una
// abierta por sucursal (validado en el servicio).
model CashSession {
  id String @id @default(uuid())

  openingAmount Decimal
  closingAmount Decimal?

  status CashSessionStatus @default(OPEN)

  branchId   String
  openedById String

  branch   Branch @relation(fields: [branchId], references: [id])
  openedBy User   @relation(fields: [openedById], references: [id])

  sales                Sale[]
  specialOrderPayments SpecialOrderPayment[]

  openedAt DateTime  @default(now())
  closedAt DateTime?

  @@index([branchId, status])
}

model Sale {
  id String @id @default(uuid())

  invoiceNumber Int

  total Decimal

  payments SalePayment[]

  isCredit Boolean @default(false)

  status SaleStatus @default(COMPLETED)

  branchId   String
  userId     String
  customerId String?
  loan       Loan?

  // Caja abierta a la que quedó asociada la venta (trazabilidad del turno).
  cashSessionId String?
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id])

  branch   Branch    @relation(fields: [branchId], references: [id])
  user     User      @relation(fields: [userId], references: [id])
  customer Customer? @relation(fields: [customerId], references: [id])

  details SaleDetail[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, invoiceNumber])
}

model SaleDetail {
  id String @id @default(uuid())

  saleId    String
  productId String

  quantity Int

  unitPrice Decimal
  discount  Decimal @default(0)

  // Motivo del descuento aplicado (si existe), para el cierre de caja.
  discountReason String?

  subtotal Decimal

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements InventoryMovement[]

  @@unique([saleId, productId])
}

model SalePayment {
  id String @id @default(uuid())

  saleId String

  amount Decimal

  paymentMethod PaymentMethod

  sale Sale @relation(fields: [saleId], references: [id])

  createdAt DateTime @default(now())
}

model Loan {
  id String @id @default(uuid())

  originalAmount Decimal
  pendingAmount  Decimal

  saleId     String @unique
  customerId String

  loanStatus LoanStatus @default(ACTIVE)

  payments LoanPayment[]

  sale     Sale     @relation(fields: [saleId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoanPayment {
  id String @id @default(uuid())

  loanId String
  amount Decimal

  paymentMethod PaymentMethod
  loan          Loan          @relation(fields: [loanId], references: [id])

  createdAt DateTime @default(now())
}

model InventoryMovement {
  id String @id @default(uuid())

  inventoryId String
  productId   String
  branchId    String
  note        String?

  quantity Int

  type InventoryMovementType

  // Vincula los dos movimientos (salida del origen, entrada al destino) de una
  // misma transferencia entre sedes. El lado negativo es el origen.
  transferGroupId String?

  saleDetailId String?

  saleDetail SaleDetail? @relation(fields: [saleDetailId], references: [id])
  inventory  Inventory   @relation(fields: [inventoryId], references: [id])
  product    Product     @relation(fields: [productId], references: [id])
  branch     Branch      @relation(fields: [branchId], references: [id])

  createdAt DateTime @default(now())
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// #2 Solicitud de traslado de mercancía entre sedes. El vendedor la crea en
// estado PENDING sin tocar inventario; el administrador la aprueba (se aplica
// el movimiento tipo BRANCH_TRANSFER, igual que inventory.transferStock) o la
// rechaza. Una solicitud es de un solo producto por simplicidad del flujo.
model BranchTransferRequest {
  id String @id @default(uuid())

  fromBranchId String
  toBranchId   String
  productId    String
  quantity     Int

  status RequestStatus @default(PENDING)

  note            String?
  // Vincula los dos InventoryMovement generados al aprobar (salida/entrada).
  transferGroupId String?

  requestedById String
  resolvedById  String?
  resolvedAt    DateTime?

  fromBranch  Branch  @relation("TransferFromBranch", fields: [fromBranchId], references: [id])
  toBranch    Branch  @relation("TransferToBranch", fields: [toBranchId], references: [id])
  product     Product @relation(fields: [productId], references: [id])
  requestedBy User    @relation("TransferRequestedBy", fields: [requestedById], references: [id])
  resolvedBy  User?   @relation("TransferResolvedBy", fields: [resolvedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([fromBranchId, status])
}

// #3 Pedido especial: repuesto que un cliente pide y que no se registra como
// producto del inventario. Guarda el valor total, lo abonado y el saldo, y va
// avanzando de estado. Los pagos (abono y saldo) viven en SpecialOrderPayment
// para poder reflejarlos en el cierre de caja.
model SpecialOrder {
  id String @id @default(uuid())

  customerName String
  partName     String
  description  String?

  totalAmount     Decimal
  depositedAmount Decimal @default(0)
  // Costo del repuesto (lo que le costó al negocio conseguirlo). Solo lo
  // ingresa/ve el ADMIN; se usa para la ganancia. Opcional: null = sin costear.
  cost            Decimal?

  status SpecialOrderStatus @default(DEPOSITED)

  estimatedArrival DateTime?

  branchId    String
  createdById String

  branch    Branch @relation(fields: [branchId], references: [id])
  createdBy User   @relation(fields: [createdById], references: [id])

  payments SpecialOrderPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([branchId, status])
}

// Cada movimiento de dinero de un pedido especial (abono inicial o saldo
// final). Queda asociado a la caja abierta del momento para el cuadre.
model SpecialOrderPayment {
  id String @id @default(uuid())

  specialOrderId String
  amount         Decimal
  paymentMethod  PaymentMethod
  kind           SpecialOrderPaymentKind

  cashSessionId String?

  specialOrder SpecialOrder @relation(fields: [specialOrderId], references: [id], onDelete: Cascade)
  cashSession  CashSession? @relation(fields: [cashSessionId], references: [id])

  createdAt DateTime @default(now())

  @@index([cashSessionId])
}

// #4 Ítem de la lista de "mercancía por comprar". Puede ser AUTO (sugerido por
// el sistema según bajo stock/rotación, materializado al confirmarlo) o MANUAL
// (agregado por un vendedor, con observaciones). productId es opcional para
// permitir anotar algo que aún no existe como producto.
model PurchaseListItem {
  id String @id @default(uuid())

  productId String?
  // Texto libre para ítems sin producto asociado (p. ej. algo nuevo por pedir).
  label     String?
  note      String?
  // Cantidad a comprar que decide el vendedor (obligatoria a nivel de app;
  // opcional en BD para no romper filas creadas antes de este campo).
  quantity  Int?

  source   PurchaseListSource @default(MANUAL)
  resolved Boolean            @default(false)

  branchId    String?
  createdById String

  product   Product? @relation(fields: [productId], references: [id])
  branch    Branch?  @relation(fields: [branchId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resolved])
}

// #5 Solicitud de cambio de precio. El vendedor propone un nuevo precio con un
// motivo; el precio del producto NO cambia hasta que el administrador aprueba.
// Al aprobar se actualiza Product.salePrice y se registra quién y cuándo.
model PriceChangeRequest {
  id String @id @default(uuid())

  productId      String
  // Precio de venta vigente al momento de crear la solicitud (referencia).
  currentPrice   Decimal
  suggestedPrice Decimal
  reason         String?

  status RequestStatus @default(PENDING)

  requestedById String
  resolvedById  String?
  resolvedAt    DateTime?

  product     Product @relation(fields: [productId], references: [id])
  requestedBy User    @relation("PriceRequestedBy", fields: [requestedById], references: [id])
  resolvedBy  User?   @relation("PriceResolvedBy", fields: [resolvedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}
